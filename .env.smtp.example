# Copy to .env.smtp, then run npm run smtp:configure. Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail application password; not the regular Google account password.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ZakupAI
SMTP_USE_TLS=true
SMTP_IMPLICIT_TLS=false
SMTP_SKIP_TLS_VERIFY=false
