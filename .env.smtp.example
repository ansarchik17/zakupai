# Used only by the separate Node SMTP relay (npm run mail:relay).
# Copy to .env.smtp; never commit the populated file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ZakupAI <invites@example.com>
# Generate a random value of at least 32 characters. Use the same value in .dev.vars.
SMTP_RELAY_TOKEN=
SMTP_RELAY_HOST=127.0.0.1
SMTP_RELAY_PORT=3025
